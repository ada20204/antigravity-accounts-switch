{
  "name": "antigravity-accounts-switch",
  "displayName": "Antigravity Accounts Switch",
  "icon": "assets/icon.png",
  "version": "1.2.0",
  "description": "Multi-account switcher and Settings quota dashboard for Google Antigravity",
  "publisher": "local",
  "main": "out/daemon/extension.js",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18.0.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "antigravityAccountsSwitch.switchAccount",
        "title": "Switch Account",
        "category": "Antigravity"
      },
      {
        "command": "antigravityAccountsSwitch.refreshQuota",
        "title": "Refresh All Quotas",
        "category": "Antigravity"
      }
    ],
    "configuration": {
      "title": "Antigravity Accounts Switch",
      "properties": {
        "antigravityAccountsSwitch.verboseLogging": {
          "type": "boolean",
          "default": false,
          "description": "Show high-volume request/frontend log lines in the Antigravity Accounts Switch Output Channel (they always go to the log file regardless)."
        }
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build:runtime": "vite build",
    "typecheck": "tsc --noEmit",
    "compile": "rm -rf out && tsc -p tsconfig.extension.json",
    "vscode:prepublish": "npm run compile && npm run build:runtime",
    "package": "vsce package --no-dependencies --no-rewrite-relative-links --allow-missing-repository --skip-license",
    "patch": "node scripts/patch.mjs",
    "unpatch": "node scripts/unpatch.mjs",
    "test": "npm run compile && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  }
}

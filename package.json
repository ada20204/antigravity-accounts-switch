{
  "name": "antigravity-accounts-switch",
  "displayName": "Antigravity Accounts Switch",
  "icon": "assets/icon.png",
  "version": "1.2.0",
  "description": "Multi-account switcher and Settings quota dashboard for Google Antigravity",
  "publisher": "174c39a3-faa3-63fd-8133-ee3abd1e2a01",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ada20204/antigravity-accounts-switch.git"
  },
  "homepage": "https://github.com/ada20204/antigravity-accounts-switch#readme",
  "bugs": {
    "url": "https://github.com/ada20204/antigravity-accounts-switch/issues"
  },
  "keywords": [
    "antigravity",
    "google-antigravity",
    "multi-account",
    "account-switcher",
    "quota"
  ],
  "main": "out/daemon/extension.js",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18.0.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "antigravityAccountsSwitch.refreshQuota",
        "title": "Refresh All Quotas",
        "category": "Antigravity"
      },
      {
        "command": "antigravityAccountsSwitch.openLogFile",
        "title": "Open Log File",
        "category": "Antigravity"
      },
      {
        "command": "antigravityAccountsSwitch.showOutput",
        "title": "Show Output Logs",
        "category": "Antigravity"
      }
    ],
    "configuration": {
      "title": "Antigravity Accounts Switch",
      "properties": {
        "antigravityAccountsSwitch.verboseLogging": {
          "type": "boolean",
          "default": false,
          "description": "Show high-volume request/frontend log lines in the Antigravity Accounts Switch Output Channel (they always go to the log file regardless)."
        },
        "antigravityAccountsSwitch.maskEmails": {
          "type": "boolean",
          "default": true,
          "description": "Desensitize and mask account email addresses in the UI and status bar (e.g. dev***er@example.com)."
        },
        "antigravityAccountsSwitch.language": {
          "type": "string",
          "enum": ["zh", "en"],
          "default": "zh",
          "description": "Display language for Antigravity Accounts Switch UI and notifications (zh: Chinese, en: English)."
        }
      }
    }


  },
  "scripts": {
    "dev": "vite",
    "build:runtime": "vite build",
    "typecheck": "tsc --noEmit",
    "compile": "rm -rf out && tsc -p tsconfig.extension.json",
    "vscode:prepublish": "npm run compile && npm run build:runtime",
    "package": "vsce package --no-dependencies --no-rewrite-relative-links",
    "publish": "vsce publish --no-dependencies",
    "patch": "node scripts/patch.mjs",
    "unpatch": "node scripts/unpatch.mjs",
    "test": "npm run compile && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  }
}
